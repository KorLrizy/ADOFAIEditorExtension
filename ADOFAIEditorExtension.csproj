    <ProjectGuid>{4B7D1A62-8C39-4F5E-9D07-6E2B1C8A3F45}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ADOFAIEditorExtension</RootNamespace>
    <AssemblyName>ADOFAIEditorExtension</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- 游戏 UMM/Harmony DLL 以 net48 编译，需要 4.8 目标框架。
         本机未装 4.8 targeting pack 时，直接用系统运行库程序集编译（API 一致）。
         已装 targeting pack 的机器可用 /p:FrameworkPathOverride=... 覆盖。 -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>8.0</LangVersion>
    <!-- 游戏安装目录。命令行可用 /p:GameDir="..." 覆盖 -->
    <GameDir Condition="'$(GameDir)' == ''">D:\steam\steamapps\common\A Dance of Fire and Ice</GameDir>
    <ManagedDir>$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedDir>
    <!-- 编译后自动复制到游戏 Mods 目录；设 /p:DeployToGame=false 关闭 -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
